#include <stdio.h>
#include <stdlib.h>
#include <math.h>

void menu();
int lerPolinomio(int coeficientes[], int expoentes[]);
void imprimirPolinomio(int coeficientes[], int expoentes[], int grau);
int calcularValor(int coeficientes[], int expoentes[], int grau, int x);
int somarPolinomios(int coeficientes1[], int expoentes1[], int grau1, int coeficientes2[], int expoentes2[], int grau2, int resultadoCoeficientes[], int resultadoExpoentes[]);
int multiplicarPolinomios(int coeficientes1[], int expoentes1[], int grau1, int coeficientes2[], int expoentes2[], int grau2, int resultadoCoeficientes[], int resultadoExpoentes[]);

int main() {
    int opcao;
    int p1_coefs[21], p2_coefs[21], resultado_coefs[21]; 
    int p1_exps[21], p2_exps[21], resultado_exps[21];
    int p1_grau, p2_grau, resultado_grau;
    int x, valor;

    do {
        menu();
        printf("\nEscolha uma opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            printf("\n--- Calcular Valor de um Polinomio ---\n");
            p1_grau = lerPolinomio(p1_coefs, p1_exps);
            printf("Digite o valor de x: ");
            scanf("%d", &x);
            valor = calcularValor(p1_coefs, p1_exps, p1_grau, x);
            printf("\nO valor do polinomio P(x) e: %d\n", valor);

        } else if (opcao == 2) {
            printf("\n--- Somar Polinomios ---\n");
            printf("Polinomio 1:\n");
            p1_grau = lerPolinomio(p1_coefs, p1_exps);
            printf("Polinomio 2:\n");
            p2_grau = lerPolinomio(p2_coefs, p2_exps);
            
            resultado_grau = somarPolinomios(p1_coefs, p1_exps, p1_grau, p2_coefs, p2_exps, p2_grau, resultado_coefs, resultado_exps);
            
            printf("\nO polinomio resultado da soma e: ");
            imprimirPolinomio(resultado_coefs, resultado_exps, resultado_grau);

        } else if (opcao == 3) {
            printf("\n--- Multiplicar Polinomios ---\n");
            printf("Polinomio 1:\n");
            p1_grau = lerPolinomio(p1_coefs, p1_exps);
            printf("Polinomio 2:\n");
            p2_grau = lerPolinomio(p2_coefs, p2_exps);
            
            resultado_grau = multiplicarPolinomios(p1_coefs, p1_exps, p1_grau, p2_coefs, p2_exps, p2_grau, resultado_coefs, resultado_exps);
            
            printf("\nO polinomio resultado da multiplicacao e: ");
            imprimirPolinomio(resultado_coefs, resultado_exps, resultado_grau);

        } else if (opcao == 0) {
            printf("\nSaindo da calculadora.\n");
        } else {
            printf("\nOpcao invalida. Tente novamente.\n");
        }

        printf("\n");
    } while (opcao != 0);

    return 0;
}

void menu() {
    printf("--- Calculadora de Polinomios ---\n");
    printf("1. Calcular o valor de um polinomio\n");
    printf("2. Somar dois polinomios\n");
    printf("3. Multiplicar dois polinomios\n");
    printf("0. Sair\n");
}

int lerPolinomio(int coeficientes[], int expoentes[]) {
    int grau_lido;
    printf("Digite o grau do polinomio (maximo 10): ");
    scanf("%d", &grau_lido);

    if (grau_lido > 10) {
        printf("Grau muito alto. Usando o grau maximo 10.\n");
        grau_lido = 10;
    }

    // Limpa o vetor de coeficientes para evitar lixo de memória
    for(int j = 0; j <= 20; j++) coeficientes[j] = 0;

    for (int i = grau_lido; i >= 0; i--) {
        printf("Digite o coeficiente de x^%d: ", i);
        scanf("%d", &coeficientes[i]);
        expoentes[i] = i;
    }
    return grau_lido;
}

void imprimirPolinomio(int coeficientes[], int expoentes[], int grau) {
    int i;
    printf("P(x) = ");
    int primeiroTermo = 1; 

    for (i = grau; i >= 0; i--) {
        if (coeficientes[i] != 0) {
            if (!primeiroTermo && coeficientes[i] > 0) {
                printf(" + ");
            }
            if (coeficientes[i] < 0 && !primeiroTermo) {
                printf(" "); // Espaço para negativos após o primeiro termo
            }

            if (expoentes[i] > 1) {
                printf("%dx^%d", coeficientes[i], expoentes[i]);
            } else if (expoentes[i] == 1) {
                printf("%dx", coeficientes[i]);
            } else {
                printf("%d", coeficientes[i]);
            }
            primeiroTermo = 0;
        }
    }
    printf("\n");
}

int calcularValor(int coeficientes[], int expoentes[], int grau, int x) {
    int resultado = 0; 
    for (int i = 0; i <= grau; i++) {
        resultado += coeficientes[i] * pow(x, expoentes[i]);
    }
    return resultado;
}

int somarPolinomios(int coeficientes1[], int expoentes1[], int grau1, int coeficientes2[], int expoentes2[], int grau2, int resultadoCoeficientes[], int resultadoExpoentes[]) {
    int grau_res = (grau1 > grau2) ? grau1 : grau2;

    for (int i = 0; i <= 20; i++) {
        resultadoCoeficientes[i] = 0;
        resultadoExpoentes[i] = i;
    }

    for (int i = 0; i <= grau1; i++) {
        resultadoCoeficientes[i] += coeficientes1[i];
    }
    for (int i = 0; i <= grau2; i++) {
        resultadoCoeficientes[i] += coeficientes2[i];
    }
    return grau_res;
}

int multiplicarPolinomios(int coeficientes1[], int expoentes1[], int grau1, int coeficientes2[], int expoentes2[], int grau2, int resultadoCoeficientes[], int resultadoExpoentes[]) {
    int grau_res = grau1 + grau2;

    for (int i = 0; i <= 20; i++) {
        resultadoCoeficientes[i] = 0;                 
        resultadoExpoentes[i] = i;
    }

    for (int i = 0; i <= grau1; i++) {
        for (int j = 0; j <= grau2; j++) {
            resultadoCoeficientes[i + j] += coeficientes1[i] * coeficientes2[j];
        }
    }
    return grau_res;
}